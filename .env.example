# Copier en `.env` (sur le VPS : à la racine du dépôt). Ne jamais committer le vrai fichier.
# Le domaine et le routage HTTPS sont gérés par le proxy Caddy partagé du VPS : voir
# ./Caddyfile (ce dépôt) et docs/add-a-service.md du dépôt opt.

# --- Supabase (projet yhzfewtarlttlncqjebj) : Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yhzfewtarlttlncqjebj.supabase.co
# Clé « anon » / publishable : publique par conception (protégée par la RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : SECRÈTE, contourne la RLS. Uniquement sur le VPS (worker).
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifications
# Resend (email). Sans domaine vérifié, l'expéditeur par défaut ne peut écrire qu'à TON adresse.
RESEND_API_KEY=
EMAIL_FROM=Bourse Tracker <onboarding@eliott-roussille.fr>

# --- Supervision : URL de « ping » Healthchecks.io (alerte si le worker s'arrête)
HEALTHCHECKS_PING_URL=

# --- Réglages du worker (valeurs par défaut)
POLL_INTERVAL_MS=30000
STALE_AFTER_MS=300000

# --- Sauvegardes (infra/backup.sh) : Supabase → Connect → Session pooler
# Variables séparées (et non une URL) : le mot de passe reste dans l'environnement du processus
# et n'apparaît jamais dans une ligne de commande.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# --- Source de secours des cotes (facultatif) : clé EODHD (https://eodhd.com, offre couvrant
# les places européennes). Vide : Yahoo seul. Avec une clé, le worker bascule sur EODHD après
# 3 échecs consécutifs de Yahoo, pendant 15 minutes, puis retente Yahoo.
EODHD_API_KEY=

# --- Telegram (facultatif) : jeton du robot de l'instance (BotFather). Chaque compte saisit son
# identifiant de conversation dans les réglages ; vide : canal Telegram masqué.
TELEGRAM_BOT_TOKEN=

# --- ntfy : serveurs auto-hébergés autorisés en plus de ntfy.sh (noms d'hôte, séparés par des
# virgules). Liste fermée : un compte ne peut pas faire envoyer de requêtes vers un autre hôte.
NTFY_HOSTS=
